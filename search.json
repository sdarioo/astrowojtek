---
layout: null
permalink: /search.json
---
[
{%- for post in site.posts %}
  {%- capture folder -%}{% include folder-zdjec.html post=post %}{%- endcapture %}
  {
    "title": {{ post.title | jsonify }},
    "url": {{ post.url | relative_url | jsonify }},
    "date": {{ post.date | date: "%Y-%m-%d" | jsonify }},
    "dateText": {% capture d %}{% include data-pl.html data=post.date %}{% endcapture %}{{ d | strip | jsonify }},
    "cover": {% if post.okladka %}{{ folder | append: post.okladka | jsonify }}{% else %}null{% endif %},
    "text": {{ post.content | strip_html | normalize_whitespace | jsonify }}
  }{% unless forloop.last %},{% endunless %}
{%- endfor %}
]
